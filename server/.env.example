# Копируй в .env и правь под себя. .env в git не попадает.

# Для локальной разработки — sqlite. Для прода — postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./launcher.db

# Соль/параметры не нужны — bcrypt генерирует соль сам

# Разрешённая версия сборки (для проверки обязательных модов)
DEFAULT_MC_VERSION=1.20.1
DEFAULT_LOADER=forge

# Репозиторий с релизами клиента+updater на GitHub — бэкенд сам смотрит
# последний релиз (/api/v1/launcher/version), вручную версию не прописываем
LAUNCHER_GITHUB_REPO=spbwar/McLauncher2027
LAUNCHER_ASSET_WINDOWS_HINT=windows
LAUNCHER_ASSET_MACOS_HINT=macos

# Публичный адрес бэкенда — нужен, чтобы собрать абсолютную ссылку на скин/плащ
# для Yggdrasil-профиля (клиент/Forge не понимают относительные URL)
PUBLIC_BASE_URL=http://127.0.0.1:8000
TEXTURES_STORAGE_DIR=./storage/textures
MODS_STORAGE_DIR=./storage/mods

# Пароль для входа в админку (POST /api/v1/admin/login). Если оставить пустым —
# при первом запуске сгенерируется случайный и один раз напечатается в
# консоли (см. app/core/admin_auth.py); дальше он же читается из
# storage/admin_password.txt, поэтому не меняется между перезапусками, пока
# файл не удалён. Секрет для подписи JWT (ADMIN_JWT_SECRET) генерируется
# так же — задавать его вручную обычно не нужно.
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
