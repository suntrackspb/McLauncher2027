# Копируй в .env и правь под себя. .env в git не попадает.

# Для локальной разработки — sqlite. Для прода — postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./launcher.db

# Соль/параметры не нужны — bcrypt генерирует соль сам

# Разрешённая версия сборки (для проверки обязательных модов)
DEFAULT_MC_VERSION=1.20.1
DEFAULT_LOADER=forge

# Репозиторий с релизами клиента+updater на GitHub — бэкенд сам смотрит
# последний релиз (/api/v1/launcher/version), вручную версию не прописываем
LAUNCHER_GITHUB_REPO=spbwar/McLauncher2027
LAUNCHER_ASSET_WINDOWS_HINT=windows
LAUNCHER_ASSET_MACOS_HINT=macos
